if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  if [ -d /opt/homebrew/opt/openjdk@21/bin ]; then
    export PATH="/opt/homebrew/opt/openjdk@21/bin:$PATH"
  fi
fi

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

if [ -f ~/.bashrc ]; then
  . ~/.bashrc
fi
